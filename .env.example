# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=repflow_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# Demo seed passwords (used only by `npm run seed`)
SEED_ADMIN_PASSWORD=Admin@123
SEED_STAFF_PASSWORD=Staff@123
SEED_TECH_PASSWORD=Tech@123
